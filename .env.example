# Copy to .env.local for development; set the same names in Vercel (Production and Preview). Never commit real values.

# Quick Quote email: set RESEND_API_KEY (Resend HTTP API) or the SMTP_* values (Mimecast or any SMTP relay), plus QUICK_QUOTE_FROM.
# Until then enquiries fail with a "please call" message. Resend wins when both are set.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (port 465); STARTTLS is used on 587 either way
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown on store emails and customer autoreplies, e.g. Tint a Car <noreply@tintacar.com.au>; its domain must be verified with the email provider
QUICK_QUOTE_FROM=

# Regional managers BCC'd on store emails by the store's state (comma-separated addresses)
QUICK_QUOTE_BCC_VIC_TAS=
QUICK_QUOTE_BCC_NSW_QLD_ACT=
QUICK_QUOTE_BCC_WA_SA_NT=

# reCAPTCHA v3 for the Quick Quote form; skipped while empty. Vercel BotID (no keys) plus the honeypot and rate limit run either way
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Google Maps JavaScript API key for the store finder map, restricted to the site's domains
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Zip landing widget on /articles/zip-pay/ (public merchant key)
NEXT_PUBLIC_ZIP_MERCHANT_KEY=

# MotorOne referrals API (TACEnquiry); each enquiry is pushed after the store email once the username and password are set.
# The URL defaults to the WordPress endpoint (config/quick-quote.ts); ask MotorOne for a newly issued password.
REFERRALS_API_URL=
REFERRALS_API_USERNAME=
REFERRALS_API_PASSWORD=
